# Copy this file to ".env" (in the repo root) and fill in your keys.
# The backend loads it automatically on startup.

# --- Free tier (recommended) ---------------------------------------------
# Powers the advisor's free tier. Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# --- Optional alternatives ------------------------------------------------
# Only needed if you wire these providers as the free/default tier.
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# --- Backend config (optional) -------------------------------------------
# MODEL_PATH=models/xgb_pipeline.pkl
# CORS_ORIGINS=http://localhost:3000
